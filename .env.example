# Supabase public configuration (Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-only configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Canva Connect (serveur uniquement — jamais de préfixe VITE_)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# URL de redirection déclarée dans la console Canva (correspondance exacte)
CANVA_REDIRECT_URI=https://cv-craft-pro.vercel.app/api/canva/callback
# À renseigner seulement si Canva déplace son endpoint de jeton
# CANVA_TOKEN_URL=https://api.canva.com/rest/v1/oauth/token
